# modified version of: https://github.com/scala/scala/blob/2.13.x/.gitignore

# Are you tempted to edit this file?
#
# First consider if the changes make sense for all,
# or if they are specific to your workflow/system.
# If it is the latter, you can augment this list with
# entries in .git/info/excludes
#
# see also test/files/.gitignore
#

#
# JARs aren't checked in, they are fetched by sbt
#
/lib/*.jar
/test/files/codelib/*.jar
/test/files/lib/*.jar
/test/files/speclib/instrumented.jar
/tools/*.jar

# Developer specific properties
/build.properties
/buildcharacter.properties

# might get generated when testing Jenkins scripts locally
/jenkins.properties

# target directory for build
/build/

# other
/out/
/bin/
/sandbox/

# intellij
**/.cache
/.idea
/.settings
# .vscode/

# Standard symbolic link to build/quick/bin
/qbin

# sbt's target directories
target
/project/**/target/
/test/macro-annot/target/
/test/files/target/
/test/target/
**/target/
**/project/**/target/
/build-sbt/
local.sbt
jitwatch.out

# Used by the restarr/restarrFull commands as target directories
/build-restarr/
/target-restarr/

# scala-cli
.scala-build

# metals
.metals
.bloop
project/**/metals.sbt
**/metals.sbt

.bsp
.history

# ----- end of scala template ----- #

# data & output
data/himalayas
data/taxi
data/natural-earth
data/rgi
data/osm
output/

# python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv

# jupyterlab
.virtual_documents
.ipynb_checkpoints
.Trash-1000
notebooks/*.ipynb

# jupyterlab autostart
.jupyter.log

# miscellaneous
*.bak 
metastore_db
derby.log
.whoami/
.logs/

# secrets
.netrc