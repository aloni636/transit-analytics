{
    "files.exclude": {
        // Metals
        // "**/.bloop": true,
        // "**/.metals": true,
        // "**/.bsp": true,
        // // JupyterLab
        // ".virtual_documents": true,
        // ".ipynb_checkpoints": true,
        // ".Trash-1000": true,
        // "metastore_db": true,
        // "derby.log": true,
        // ".whoami": true
    },
    "[scala]": {
        "editor.tabSize": 2,
    },
    "[terraform]": {
        "editor.tabSize": 2
    },
    "files.watcherExclude": {
        "**/target/**": true
    },
    "cSpell.words": [
        "backlink",
        "backlinks",
        "bbox",
        "cfor",
        "Chrono",
        "costdistance",
        "coursier",
        "dropoff",
        "EPSG",
        "esbuild",
        "gdal",
        "geohash",
        "geoparquet",
        "geotrellis",
        "GTFS",
        "Indicatrix",
        "insitaintaing",
        "jupyterlab",
        "jupytext",
        "Kryo",
        "learningscala",
        "lukla",
        "mapalgebra",
        "Monoid",
        "Multiband",
        "MWAA",
        "NODATA",
        "nohup",
        "OMERC",
        "Partitioner",
        "pprintln",
        "QGIS",
        "Rasterizer",
        "Reproject",
        "Reprojected",
        "Reprojecting",
        "rollup",
        "scalac",
        "scalatest",
        "sedona",
        "Singleband",
        "tfvars",
        "Tobler",
        "Trafiklab",
        "traversability",
        "tripdata",
        "trixie",
        "typeclass",
        "unpersist",
        "upcasting",
        "Viewshed",
        "webui",
        "Welford"
    ],
    "editor.codeActionsOnSave": {
        "source.organizeImports": "always"
    },
    "metals.inlayHints.hintsXRayMode.enable": false,
    "jupytextSync.pythonExecutable": "${userHome}/.local/share/pipx/venvs/jupytext/bin/python3",
    "material-icon-theme.folders.associations": {
        "worksheets": "scala",
    },
    "evenBetterToml.schema.associations": {
        ".*pyproject.toml": "https://json.schemastore.org/pyproject.json"
    },
    "material-icon-theme.files.associations": {
        "secrets.tfvars.example": "terraform"
    }
}