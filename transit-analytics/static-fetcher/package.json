{
  "name": "static-fetcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "check": "tsc --project tsconfig.json",
    "build": "pnpm run check && node esbuild.mjs",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "dev": "node --import tsx dev.ts",
    "debug": "node --inspect-brk --import tsx dev.ts",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@aws-lambda-powertools/parameters": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@transit-analytics/shared": "workspace:*",
    "dotenv": "17.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "p-retry": "8.0.0",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "@types/unzipper": "0.10.11",
    "esbuild": "catalog:",
    "jsonata": "^2.2.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  }
}
